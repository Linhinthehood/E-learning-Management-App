# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing keys - NEVER COMMIT THESE
*.jks
*.keystore
key.properties
android/key.properties
android/app/key.properties

# iOS signing - NEVER COMMIT THESE
*.p12
*.mobileprovision
*.certSigningRequest
ios/Runner.xcodeproj/project.pbxproj.bak

# macOS signing
macos/Runner.xcodeproj/project.pbxproj.bak

# macOS specific files to ignore
# CocoaPods
macos/Pods/
macos/Podfile.lock  # Optional: Keep if you want to lock dependency versions, or remove if you prefer flexibility

# Xcode user-specific files
macos/**/xcuserdata/
macos/**/*.xcuserstate
macos/**/*.xcworkspace/xcuserdata/
macos/**/*.xcodeproj/xcuserdata/
macos/**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Flutter ephemeral files (auto-generated)
macos/Flutter/ephemeral/
macos/Flutter/Flutter-Generated.xcconfig

# macOS build artifacts
macos/Flutter/FlutterInputs.xcfilelist
macos/Flutter/FlutterOutputs.xcfilelist
macos/Flutter/.last_build_id

# macOS derived data
macos/.symlinks/
macos/DerivedData/

# Environment files with secrets
.env
.env.*
!.env.example

# Firebase config with sensitive data (if you want to keep it private)
# lib/data/datasources/remote/firebase_config.dart
